# Optional. Everything in gridcast works without any API key -- CAISO and
# Open-Meteo are both keyless. The EIA key only unlocks the deep-history
# backbone (hourly CAISO demand back to July 2015).
# Free, instant, self-serve: https://www.eia.gov/opendata/
EIA_API_KEY=

# Optional overrides
# GRIDCAST_DATA_DIR=./data
# GRIDCAST_USER_AGENT="gridcast (https://github.com/you/gridcast)"
